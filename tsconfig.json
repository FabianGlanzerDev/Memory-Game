{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "Bundler",
        "rootDir": "./src/ts",
        "outDir": "./build",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noEmitOnError": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "./src/ts/**/*.ts"
    ]
}
