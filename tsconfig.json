{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noEmit": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "./src/ts/**/*.ts"
    ]
}
